{
  "manifest_version": 3,
  "name": "Model Librarian",
  "version": "0.6.1",
  "description": "One-click downloads from CivitAI and HuggingFace into ComfyUI via Model Librarian, and pictures saved for Model Librarian Gallery.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "notifications",
    "contextMenus",
    "downloads",
    "downloads.ui",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://civitai.com/*",
    "https://civitai.green/*",
    "https://civitai.red/*",
    "https://www.pixiv.net/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://mobile.twitter.com/*",
    "https://www.deviantart.com/*",
    "https://danbooru.donmai.us/*",
    "https://gelbooru.com/*",
    "https://safebooru.org/*",
    "https://yande.re/*",
    "https://konachan.com/*",
    "https://konachan.net/*",
    "https://e621.net/*",
    "https://pawchive.pw/*",
    "https://i.pximg.net/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://civitai.com/*",
        "https://civitai.green/*",
        "https://civitai.red/*"
      ],
      "js": [
        "content/civitai.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://huggingface.co/*",
        "https://civarchive.com/*",
        "https://www.civarchive.com/*"
      ],
      "js": [
        "content/sites.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.pixiv.net/*",
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*",
        "https://www.deviantart.com/*",
        "https://danbooru.donmai.us/*",
        "https://gelbooru.com/*",
        "https://safebooru.org/*",
        "https://yande.re/*",
        "https://konachan.com/*",
        "https://konachan.net/*",
        "https://e621.net/*",
        "https://pawchive.pw/*"
      ],
      "js": [
        "content/gallery.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Model Librarian",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon32.png"
      ],
      "matches": [
        "https://civarchive.com/*",
        "https://civitai.com/*",
        "https://civitai.green/*",
        "https://civitai.red/*",
        "https://danbooru.donmai.us/*",
        "https://e621.net/*",
        "https://gelbooru.com/*",
        "https://huggingface.co/*",
        "https://konachan.com/*",
        "https://konachan.net/*",
        "https://mobile.twitter.com/*",
        "https://pawchive.pw/*",
        "https://safebooru.org/*",
        "https://twitter.com/*",
        "https://www.civarchive.com/*",
        "https://www.deviantart.com/*",
        "https://www.pixiv.net/*",
        "https://x.com/*",
        "https://yande.re/*"
      ]
    }
  ]
}
